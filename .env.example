# Anthropic API Key for real Claude models (leave blank to run in deterministic mock mode)
ANTHROPIC_API_KEY=

# Anthropic Claude model to use when API key is provided
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Maximum number of candidate-answer turns before concluding the interview
MAX_TURNS=10

# Application environment and logging
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
